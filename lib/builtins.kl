(import _builtins :all)

(defmacro cond (&rest args)
  (if (is args nil)
    nil
    (let ((current (car args))
          (rest (cdr args)))
      (list 'if (car current) (cons 'progn (cdr current))
            (cons 'cond rest)))))

(defmacro and (current &rest rest)
  (cond
    ((is rest nil) current)
    ((isinstance current sym) (list 'if current (cons 'and rest) current))
    (t (let ((c (gensym)))
         (list 'let (list (list c current))
               (cons 'and (cons c rest)))))))

(defmacro or (current &rest rest)
  (cond
    ((is rest nil) current)
    ((isinstance current sym) (list 'if current current (cons 'or rest)))
    (t (let ((c (gensym)))
         (list 'let (list (list c current))
               (cons 'or (cons c rest)))))))

(defun not (arg) (if arg f t))

(import _backquote : --backquote--)

;; Set arbitrary things using the same syntax you usually use to access them.
(defmacro set (thing value)
  (cond
    ((isinstance thing sym)
     `(%setvar ,thing ,value))
    ((tuple? thing)
     (let ((head (car thing))
           (tail (cdr thing)))
       (cond
         ((is head 'getattr) `(%setattr ,@tail ,value))
         ((is head 'item) `(%setitem ,@tail ,value))
         ((is head 'car) `(%setcar ,@tail ,value))
         ((is head 'cdr) `(%setcdr ,@tail ,value))
         (t (raise
              (SyntaxError
                "value to set must be attr/item reference, cons cell element or variable, got: {0}"
                thing))))))
    (t (raise
         (SyntaxError
           "value to set must be attr/item reference, cons cell element or variable, got: {0}"
           thing)))))

;; Import definitions of the math operations.
(import mathops :all)
